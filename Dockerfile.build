FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake gcc-arm-none-eabi libnewlib-arm-none-eabi \
    libstdc++-arm-none-eabi-newlib \
    build-essential git python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/raspberrypi/pico-sdk.git /pico-sdk \
    && cd /pico-sdk && git checkout 1.5.1 && git submodule update --init --depth 1 lib/tinyusb

ENV PICO_SDK_PATH=/pico-sdk

# No default: this stage has no .git, so CMake cannot derive the commit here.
# A default would let an unstamped image build and label itself, which is worse
# than not building at all. Fail before the compile instead.
ARG FW_BUILD_ID
RUN test -n "${FW_BUILD_ID}" || { \
	echo "ERROR: this build requires --build-arg FW_BUILD_ID=<short git sha>" >&2; \
	exit 1; \
    }
WORKDIR /src
COPY main.c ssd1306.c ssd1306.h eeprom.h font.h image.h pulse_ts.pio CMakeLists.txt pico_sdk_import.cmake ./

RUN mkdir build && cd build && cmake -DFW_BUILD_ID=${FW_BUILD_ID} .. && make -j$(nproc)

FROM scratch
COPY --from=build /src/build/main.uf2 /gc10next.uf2
